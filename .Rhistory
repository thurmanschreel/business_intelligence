# 1. Define the roster webpage URL
url <- "https://miamiredhawks.com/sports/swimming-and-diving/roster"
# 2. Read the webpage HTML (Class 10 - Step 1: Read)
page <- rvest::read_html(url)
# 3. Extract athlete names using CSS selectors (Class 10 - Step 2 & 3: Select & Extract)
names <- page |>
rvest::html_elements(".sidearm-roster-player-name") |>
rvest::html_text2()
# 4. Extract athlete hometowns/locations using CSS selectors
locations <- page |>
rvest::html_elements(".sidearm-roster-player-hometown") |>
rvest::html_text2()
# 5. Create the required swim_df tibble containing name and location columns
swim_df <- tibble::tibble(
name = names,
location = locations
)
# Inspect the result
dplyr::glimpse(swim_df)
print(swim_df)
