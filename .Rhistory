url <- "https://miamioh.edu/policy-library/students/undergraduate/academic-regulations/index.html"
# 2. Read the HTML code from the webpage
page <- rvest::read_html(url)
# 3. Extract all links (href attributes) inside the main content area
raw_links <- page |>
rvest::html_elements("main a") |>
rvest::html_attr("href")
# 4. Convert relative links to absolute URLs and store in mu_policies
mu_policies <- xml2::url_absolute(raw_links, base = url)
# 5. Filter to keep only the academic regulation policy links (27 policies)
mu_policies <- mu_policies[stringr::str_detect(mu_policies, "/academic-regulations/")]
# Inspect the final character vector
print(mu_policies)
url <- "https://miamioh.edu/policy-library/students/undergraduate/academic-regulations/index.html"
# 2. Read the page HTML (Class 10 Step 1)
page <- rvest::read_html(url)
# 3. Extract the href attribute from all main content links (Class 10 Steps 2 & 3)
raw_links <- page |>
rvest::html_elements("main a") |>
rvest::html_attr("href")
# 4. Filter for policy links containing "academic-regulations" (Class 03 / 10 Subsetting)
policy_paths <- raw_links[stringr::str_detect(raw_links, "academic-regulations")]
# 5. Build full URLs by combining the base domain with relative paths using paste0()
mu_policies <- paste0("https://miamioh.edu", policy_paths)
# 6. Ensure unique links and remove duplicate index references
mu_policies <- unique(mu_policies)
# Inspect the final character vector
print(mu_policies)
